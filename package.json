{
  "name": "se-lab01-svg-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript 面向对象 SVG 命令行编辑器",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cli": "node --import tsx src/presentation/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
