{
  "name": "se-lab01-svg-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript 面向对象 SVG 命令行编辑器",
  "engines": { "node": ">=22" },
  "scripts": {
    "cli": "tsx src/presentation/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  }
}
